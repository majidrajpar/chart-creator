---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact — QuickChartMaker"
  description="Get in touch with the QuickChartMaker team."
>
  <h1 class="text-2xl font-black text-slate-900 mb-6">Contact</h1>
  <div class="prose prose-slate max-w-2xl text-sm leading-relaxed text-slate-600 space-y-4">
    <p>Have a suggestion, found a bug, or want to request a new chart type?</p>
    <p>
      Email us at <a href="mailto:majidrajpar@gmail.com" class="text-slate-800 underline">majidrajpar@gmail.com</a>
      and we'll get back to you.
    </p>
  </div>
</Base>
