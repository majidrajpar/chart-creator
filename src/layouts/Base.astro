---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
}

const { title, description, canonicalUrl } = Astro.props;
const ogImage = '/og-image.png';
const siteUrl = 'https://quickchartmaker.com';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl ?? siteUrl + Astro.url.pathname} />

    <!-- OG / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- AdSense placeholder — add publisher ID after approval -->
    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->
  </head>
  <body class="bg-white text-slate-800 antialiased">

    <header class="border-b border-slate-200">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="font-black text-lg tracking-tight text-slate-900">
          QuickChartMaker
        </a>
        <nav class="flex gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-slate-900">Tool</a>
          <a href="/blog" class="hover:text-slate-900">Guides</a>
          <a href="/about" class="hover:text-slate-900">About</a>
        </nav>
      </div>
    </header>

    <!-- Ad slot: top banner -->
    <div id="ad-slot-top" class="max-w-5xl mx-auto px-4 pt-4">
      <!-- AdSense banner ad goes here after approval -->
    </div>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Ad slot: below content -->
    <div id="ad-slot-bottom" class="max-w-5xl mx-auto px-4 pb-8">
      <!-- AdSense rectangle ad goes here after approval -->
    </div>

    <footer class="border-t border-slate-200 mt-8">
      <div class="max-w-5xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
        <span>© {new Date().getFullYear()} QuickChartMaker — Free online chart maker</span>
        <div class="flex gap-4">
          <a href="/privacy" class="hover:text-slate-700">Privacy Policy</a>
          <a href="/about" class="hover:text-slate-700">About</a>
          <a href="/contact" class="hover:text-slate-700">Contact</a>
        </div>
      </div>
    </footer>

  </body>
</html>
